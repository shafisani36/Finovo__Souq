# Requests go to /api/v1 on the Vite dev server, which proxies them to the Express backend.
VITE_API_URL=/api/v1
# Where the dev proxy sends /api requests (the backend's PORT, default 5000)
VITE_PROXY_TARGET=http://localhost:5000

# "true": everything runs on the in-browser mock API, no backend needed (demo mode).
VITE_USE_MOCK_API=false

# "true": endpoints the backend does not have yet (listings, messages, dashboards...) use the mock API,
# while authentication goes to the real backend. Set to "false" once the backend serves them.
VITE_MOCK_PENDING_ENDPOINTS=true
