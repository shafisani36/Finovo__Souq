# Backend API base URL. Keep the API on the same site as the frontend (e.g. a reverse proxy that sends
# /api and /socket.io to the backend), because the refresh-token cookie is SameSite=Strict.
VITE_API_URL=/api/v1

# Development only: where Vite proxies /api and /socket.io
VITE_PROXY_TARGET=http://localhost:5000
