# Backend API base URL. Use /api/v1 in development (Vite proxies it), the full URL in production,
# e.g. https://api.finovosouq.com/api/v1 (the backend CLIENT_URL must then be this site's URL).
VITE_API_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:5000

# "true": run everything on the in-browser mock API (no backend). Must be "false" in production.
VITE_USE_MOCK_API=false

# "true": endpoints the backend does not serve yet are answered by the mock API.
# Must be "false" in production.
VITE_MOCK_PENDING_ENDPOINTS=true
