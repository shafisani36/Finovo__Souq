PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/finovo_souq

# Long random strings, different from each other: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# The frontend's URL (CORS and the live chat socket)
CLIENT_URL=http://localhost:5177

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Where ad photos, profile photos and voice messages are stored; back this folder up
UPLOAD_DIR=uploads

# Gmail SMTP for password reset codes (use a Google App Password, not the account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Finovo Souq"

# debug, info, warn or error (default: info in production, debug in development)
LOG_LEVEL=
